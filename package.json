{
  "type": "module",
  "name": "urls.wtf",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "clean": "rm -rf .svelte-kit .vercel node_modules",
    "dev": "vite dev",
    "build": "vite build",
    "build-prod": "pnpm run db:migrate && vite build",
    "preview": "vite preview",
    "ts-check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "ts-check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "prettier --check .",
    "format": "prettier --write .",
    "ci": "npm run lint && npm run ts-check && npm run build && npm run test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "svelte-kit sync && drizzle-kit migrate",
    "db:migrate:test": "svelte-kit sync && node --env-file=.env.test ./node_modules/drizzle-kit/bin.cjs migrate",
    "test": "pnpm run db:migrate:test && node --env-file=.env.test ./node_modules/@playwright/test/cli.js test",
    "test:ui": "pnpm run db:migrate:test && node --env-file=.env.test ./node_modules/@playwright/test/cli.js test --ui",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@sveltejs/adapter-vercel": "^7.0.2",
    "@sveltejs/kit": "^3.1.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "autoprefixer": "^10.6.2",
    "dotenv": "^18.0.9",
    "drizzle-kit": "1.0.0-rc.5",
    "postcss": "^8.5.32",
    "prettier": "^3.9.10",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "tailwindcss": "^4.3.5",
    "typescript": "^6.0.3",
    "vite": "^8.3.6"
  },
  "dependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "drizzle-orm": "1.0.0-rc.5",
    "effect": "4.1.2",
    "postgres": "^4.1.0"
  },
  "engines": {
    "node": "26.x"
  },
  "packageManager": "pnpm@12.18.0",
  "imports": {
    "#lib": "./src/lib/index.js",
    "#lib/*": "./src/lib/*"
  }
}
